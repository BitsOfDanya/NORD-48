APP_NAME=NORD-48
APP_ENV=development
APP_DEBUG=true

API_V1_PREFIX=/api/v1

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# Optional. Only needed when the repo-root data/ directory isn't reachable
# by relative path from this file (e.g. in Docker) — docker-compose.yml
# sets this automatically. Leave unset for local `uv run uvicorn` dev.
# SCENARIOS_DIR=/app/data/scenarios/raw

# Optional. Durable storage path for completed simulation runs, so run_id
# links survive container rebuilds/restarts. Unset means runs are kept
# in-memory only, for the process lifetime.
# RUNS_DIR=/data/runs
